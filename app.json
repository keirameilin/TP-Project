{
  "expo": {
    "name": "TP-Project",
    "slug": "TP-Project",
    "scheme": "tpproject",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.keiralin.TPProject",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "server"
    },
    "plugins": [
      "expo-sqlite",
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use your camera to photograph food and estimate its macros.",
          "photosPermission": "Allow $(PRODUCT_NAME) to open your photos so you can pick a food picture to estimate its macros."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "45d0db35-a5e9-4e82-8a84-c77ae853175d"
      }
    }
  }
}
